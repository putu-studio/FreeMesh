# The chip: XIAO ESP32-S3
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_LWIP_MAX_SOCKETS=16
# Holding the D1 button for 5 s while the box starts returns the box to FreeMesh from any mode.
# The bootloader, which never changes, then clears the chosen slot and starts slot 0, which is FreeMesh.
CONFIG_BOOTLOADER_FACTORY_RESET=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=2
CONFIG_BOOTLOADER_FACTORY_RESET_PIN_LOW=y
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
CONFIG_BOOTLOADER_DATA_FACTORY_RESET=""
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=5
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# The https server refuses connections from other apps early and lets phones resume a session (app_web.c).
CONFIG_ESP_HTTPS_SERVER_CERT_SELECT_HOOK=y
CONFIG_ESP_TLS_SERVER_CERT_SELECT_HOOK=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# ESP-IDF 6.x: let mbedTLS write the box's own https certificate (off by default there)
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
# Making the https certificate (once, at first start) needs a big stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
# Bluetooth for the FreeMesh phone app (app_ble.c)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_LWIP_NETIF_LOOPBACK=y
# On the S3, fast code (IRAM) and data share the same RAM.
# Wi-Fi code stays out of IRAM and the Wi-Fi buffers are limited so that Wi-Fi, HTTPS and BLE fit in RAM together.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# BLE uses only plain (4.x) advertising and up to 3 phones.
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_CTRL_BLE_MAX_ACT=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# The CPU traps a write past the end of a task's stack, and the RAM report lists tasks low on stack.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
