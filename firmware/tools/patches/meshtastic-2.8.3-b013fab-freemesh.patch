diff --git a/src/platform/esp32/FreeMeshReturn.cpp b/src/platform/esp32/FreeMeshReturn.cpp
new file mode 100644
index 0000000..2516f62
--- /dev/null
+++ b/src/platform/esp32/FreeMeshReturn.cpp
@@ -0,0 +1,47 @@
+#ifdef FREEMESH
+// FreeMesh box: hold the mode button (XIAO D1 = GPIO2, to GND) for 5 s and the box restarts in FreeMesh.
+// Called from loop(). Polls every 20 ms, so a bump does nothing.
+#include "FreeMeshReturn.h"
+#include <Arduino.h>
+#include <esp_ota_ops.h>
+#include <esp_partition.h>
+
+#define FREEMESH_BTN 2
+#define FREEMESH_HOLD_MS 5000
+#define FREEMESH_LED 48     // on = HIGH. Off all the time, pulses while you hold the button
+
+void freemeshReturnPoll()
+{
+    static bool init = false;
+    static uint32_t last = 0, down_at = 0;
+    if (!init) {
+        pinMode(FREEMESH_BTN, INPUT_PULLUP);
+        pinMode(FREEMESH_LED, OUTPUT);
+        digitalWrite(FREEMESH_LED, LOW);
+        init = true;
+    }
+    uint32_t now = millis();
+    if (now - last < 20)
+        return;
+    last = now;
+    if (digitalRead(FREEMESH_BTN) != LOW) {
+        if (down_at) digitalWrite(FREEMESH_LED, LOW);   // let go: LED off
+        down_at = 0;
+        return;
+    }
+    if (down_at == 0)
+        down_at = now ? now : 1;
+    if (now - down_at >= 500) digitalWrite(FREEMESH_LED, (now / 100) % 2);   // holding: fast pulse
+    if (now - down_at < FREEMESH_HOLD_MS)
+        return;
+    const esp_partition_t *p = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_ANY, "freemesh");
+    if (p && esp_ota_set_boot_partition(p) == ESP_OK) {
+        Serial.println("FreeMesh button: switching back to FreeMesh");
+        for (int i = 0; i < 8; i++) { digitalWrite(FREEMESH_LED, i % 2 == 0); delay(100); }   // switching
+        digitalWrite(FREEMESH_LED, HIGH);
+        esp_restart();
+    }
+    digitalWrite(FREEMESH_LED, LOW);
+    down_at = 0; // no freemesh slot: try again on the next hold
+}
+#endif
